{
  "name": "@openarch/plugin",
  "version": "0.1.5",
  "description": "OpenArch 架构治理工具——Coding Agent 插件。防腐主线闭环 + 多平台适配（Claude Code、Cursor、Codex、OpenCode、DeepSeek Harness）。",
  "author": "VilTea <https://github.com/VilTea>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dsh/host/openarch-dashboard-host.mjs",
    "./client": "./lib/client.js",
    "./host-tools": "./dsh/host/openarch-tools.mjs",
    "./host-signals": "./dsh/host/openarch-signals.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "bin": {
    "openarch-agent-install": "./bin/openarch-agent-install.js"
  },
  "scripts": {
    "build:client": "node scripts/build-dsh-client.mjs",
    "prepack": "node scripts/build-dsh-client.mjs",
    "test": "node scripts/build-dsh-client.mjs && vitest run --testTimeout=15000"
  },
  "files": [
    "bin",
    "assets",
    "skills",
    "commands",
    "dsh",
    "scripts",
    "lib",
    "cordis.patch.yml",
    ".codex-plugin",
    ".claude-plugin",
    ".cursor-plugin",
    ".codex",
    ".opencode",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openarch",
    "architecture",
    "governance",
    "skills",
    "claude-code",
    "cursor",
    "codex",
    "opencode",
    "deepseek-harness",
    "code-quality"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openarch/openarch.git"
  }
}
